// SplitFree — Prisma Schema
// Supabase PostgreSQL backend

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured in prisma.config.ts (Prisma 7+)
}

// ─── Enums ──────────────────────────────────────────────────

enum Currency {
  USD
  EUR
  GBP
  INR
  CAD
  AUD
  JPY
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  ACCOMMODATION
  ENTERTAINMENT
  UTILITIES
  SHOPPING
  HEALTH
  TRAVEL
  EDUCATION
  OTHER
}

enum GroupCategory {
  HOME
  TRIP
  COUPLE
  FRIENDS
  WORK
  OTHER
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  EXPENSE_COMMENTED
  SETTLEMENT_ADDED
  GROUP_JOINED
  GROUP_LEFT
  FRIEND_ADDED
  PAYMENT_REMINDER
}

enum ActivityType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_CREATED
  GROUP_CREATED
  MEMBER_ADDED
  MEMBER_REMOVED
}

// ─── Models ─────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) // matches Supabase auth.users.id
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  currency  Currency @default(INR)
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groupMemberships GroupMember[]
  createdGroups    Group[]        @relation("GroupCreator")
  paidExpenses     Expense[]      @relation("ExpensePayer")
  expenseSplits    ExpenseSplit[]
  sentSettlements  Settlement[]   @relation("SettlementSender")
  recvSettlements  Settlement[]   @relation("SettlementReceiver")
  notifications    Notification[]
  activities       Activity[]
  friendships      Friendship[]   @relation("UserFriendships")
  friendOf         Friendship[]   @relation("FriendOf")
  sentInvites      GroupInvite[]  @relation("SentInvites")
  comments         ExpenseComment[]
  reactions        ExpenseReaction[]
  budgets          Budget[]
  expensePayments  ExpensePayer[]
  revisions        ExpenseRevision[]
  pushSubscriptions PushSubscription[]
  emailNotifications Boolean       @default(true) @map("email_notifications")
  upiId            String?        @map("upi_id") // payment address shown to people who owe you (INR)
  phone            String?        // mobile number in international format (+919876543210); required for new accounts, not verified

  @@map("users")
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  imageUrl    String?       @map("image_url")
  category    GroupCategory @default(OTHER)
  currency    Currency      @default(INR)
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  inviteToken          String?       @unique @map("invite_token")
  inviteTokenExpiresAt DateTime?     @map("invite_token_expires_at")
  archivedAt           DateTime?     @map("archived_at")

  createdBy   User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  activities  Activity[]
  invites     GroupInvite[]
  budgets     Budget[]

  @@map("groups")
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String    @map("group_id")
  userId   String    @map("user_id")
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Expense {
  id                String             @id @default(uuid())
  groupId           String?            @map("group_id")
  description       String
  amount            Int                // stored in cents
  currency          Currency           @default(INR)
  category          ExpenseCategory    @default(OTHER)
  splitType         SplitType          @default(EQUAL)
  paidById          String             @map("paid_by_id")
  date              DateTime
  isRecurring          Boolean            @default(false) @map("is_recurring")
  recurringInterval    RecurringInterval? @map("recurring_interval")
  recurringParentId    String?            @map("recurring_parent_id")
  lastRecurredAt       DateTime?          @map("last_recurred_at")
  notes             String?
  receiptUrl        String?            @map("receipt_url")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  group             Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  paidBy            User           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Cascade)
  splits            ExpenseSplit[]
  activities        Activity[]
  comments          ExpenseComment[]
  reactions         ExpenseReaction[]
  payers            ExpensePayer[]
  revisions         ExpenseRevision[]
  recurringParent   Expense?       @relation("RecurringChildren", fields: [recurringParentId], references: [id], onDelete: SetNull)
  recurringChildren Expense[]      @relation("RecurringChildren")

  @@index([groupId])
  @@index([paidById])
  @@index([paidById, date])
  @@index([date])
  @@index([recurringParentId])
  @@index([groupId, date(sort: Desc)]) // a group's expense list, newest first
  @@index([isRecurring]) // the daily job that creates recurring expenses
  @@map("expenses")
}

model ExpenseSplit {
  id         String   @id @default(uuid())
  expenseId  String   @map("expense_id")
  userId     String   @map("user_id")
  amount     Int      // in cents
  percentage Float?
  shares     Int?
  isPaid     Boolean  @default(false) @map("is_paid")
  createdAt  DateTime @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

model Settlement {
  id         String   @id @default(uuid())
  groupId    String?  @map("group_id")
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  amount     Int      // in cents
  currency   Currency @default(INR)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  group    Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  fromUser User   @relation("SettlementSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User   @relation("SettlementReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("settlements")
}

model Friendship {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  friendId  String           @map("friend_id")
  status    FriendshipStatus @default(PENDING) @map("status")
  createdAt DateTime         @default(now()) @map("created_at")

  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  data      Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Activity {
  id           String       @id @default(uuid())
  type         ActivityType
  userId       String       @map("user_id")
  groupId      String?      @map("group_id")
  expenseId    String?      @map("expense_id")
  settlementId String?      @map("settlement_id")
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)]) // the latest activity for a person (dashboard, activity page)
  @@index([userId])
  @@index([groupId])
  @@index([expenseId])
  @@map("activities")
}

model GroupInvite {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  email     String
  invitedBy String   @map("invited_by")
  createdAt DateTime @default(now()) @map("created_at")

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation("SentInvites", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([groupId, email])
  @@index([email])
  @@map("group_invites")
}

model ExpenseComment {
  id        String   @id @default(uuid())
  expenseId String   @map("expense_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_comments")
}

/// A quick emoji reaction on an expense (one row per person per emoji)
model ExpenseReaction {
  id        String   @id @default(uuid())
  expenseId String   @map("expense_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId, emoji])
  @@index([expenseId])
  @@map("expense_reactions")
}

model Budget {
  id        String           @id @default(uuid())
  groupId   String?          @map("group_id")
  userId    String           @map("user_id")
  category  ExpenseCategory?
  amount    Int              // in cents, monthly limit
  period    BudgetPeriod     @default(MONTHLY)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, category])
  @@index([userId])
  @@index([groupId])
  @@map("budgets")
}


// Extra payers for an expense. When an expense has no rows here, `Expense.paidById` paid the full amount.
// When it has rows, they say how much each person paid (amounts sum to Expense.amount).
model ExpensePayer {
  id        String   @id @default(uuid())
  expenseId String   @map("expense_id")
  userId    String   @map("user_id")
  amount    Int      // cents paid by this person
  createdAt DateTime @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_payers")
}

// Edit history: one row per PATCH with the before/after of every changed field.
model ExpenseRevision {
  id        String   @id @default(uuid())
  expenseId String   @map("expense_id")
  userId    String   @map("user_id")
  changes   Json     // { field: { from, to } }
  createdAt DateTime @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId, createdAt])
  @@map("expense_revisions")
}

// Web Push (VAPID) subscriptions — one per browser/device.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// People who asked to be told when the iPhone app launches (landing page). Only an email address, kept for that purpose.
model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist")
}

