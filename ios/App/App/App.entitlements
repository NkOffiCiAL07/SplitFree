<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links: https://splitfree-xi.vercel.app/join/… (WhatsApp invites) open in the app. Needs the
	     apple-app-site-association file on the site with your Team ID (see ios/README.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:splitfree-xi.vercel.app</string>
	</array>
</dict>
</plist>
